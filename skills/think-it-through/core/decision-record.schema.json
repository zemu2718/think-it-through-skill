{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemu2718/think-it-through-skill/schemas/v0.2.0/decision-record.schema.json",
  "title": "Think It Through v0.2.0 Decision Record",
  "type": "object",
  "required": [
    "contract_version",
    "topic",
    "true_objectives",
    "decision",
    "judgment",
    "evidence",
    "reversal_signals",
    "main_experiment",
    "reassessment_triggers",
    "participation_and_capabilities",
    "persistence"
  ],
  "properties": {
    "contract_version": {"const": "0.2.0"},
    "record_id": {"type": "string", "minLength": 1},
    "created_at": {"type": "string", "format": "date-time"},
    "topic": {"type": "string", "minLength": 1},
    "true_objectives": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "decision": {"type": "string", "minLength": 1},
    "confirmed_methods": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "judgment": {
      "type": "object",
      "required": ["state", "recommendation", "rationale", "validity_conditions"],
      "properties": {
        "state": {"enum": ["hold", "small_test", "proceed_conditionally", "proceed", "continue", "adjust", "pause", "stop"]},
        "recommendation": {"type": "string", "minLength": 1},
        "rationale": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "validity_conditions": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": ["confirmed_facts", "inferences", "assumptions", "unknowns", "sources"],
      "properties": {
        "confirmed_facts": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "inferences": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "assumptions": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "unknowns": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["title", "locator", "evidence_date"],
            "properties": {
              "title": {"type": "string", "minLength": 1},
              "locator": {"type": "string", "minLength": 1},
              "evidence_date": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "reversal_signals": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "main_experiment": {
      "type": "object",
      "required": ["core_hypothesis", "action", "observation", "reassessment"],
      "properties": {
        "core_hypothesis": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "observation": {"type": "string", "minLength": 1},
        "reassessment": {"type": "string", "minLength": 1},
        "user_supplied_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "suggested_boundaries": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "reassessment_triggers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "participation_and_capabilities": {
      "type": "object",
      "required": ["main_agents", "additional_agents_planned", "additional_agents_started", "additional_agents_completed", "additional_agents_failed", "private_data_accessed", "external_action_executed", "consent_ids", "receipt_ids"],
      "properties": {
        "main_agents": {"const": 1},
        "additional_agents_planned": {"type": "integer", "minimum": 0},
        "additional_agents_started": {"type": "integer", "minimum": 0},
        "additional_agents_completed": {"type": "integer", "minimum": 0},
        "additional_agents_failed": {"type": "integer", "minimum": 0},
        "human_participants_requested": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "capabilities_used": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "private_data_accessed": {"type": "boolean"},
        "external_action_executed": {"type": "boolean"},
        "consent_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "receipt_ids": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "conflicts_and_gaps": {"type": "array", "items": {"type": "string", "minLength": 1}}
      },
      "additionalProperties": false
    },
    "persistence": {
      "type": "object",
      "required": ["mode", "authorized"],
      "properties": {
        "mode": {"enum": ["conversation_only", "authorized_file", "authorized_remote"]},
        "authorized": {"type": "boolean"},
        "destination": {"type": "string", "minLength": 1},
        "consent_id": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"mode": {"const": "conversation_only"}}},
          "then": {"properties": {"authorized": {"const": false}}}
        },
        {
          "if": {"properties": {"mode": {"enum": ["authorized_file", "authorized_remote"]}}},
          "then": {"required": ["destination", "consent_id"], "properties": {"authorized": {"const": true}}}
        }
      ]
    }
  },
  "additionalProperties": false
}
