{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/zemu2718/think-it-through-skill/compatibility/v1/evidence.schema.json",
  "title": "Think It Through Compatibility Evidence",
  "type": "object",
  "required": [
    "schema_version",
    "evidence_id",
    "kind",
    "skill",
    "source_commit",
    "package_sha256",
    "environment",
    "levels",
    "cases",
    "artifacts",
    "review",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {"const": "1"},
    "evidence_id": {"type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"},
    "kind": {"enum": ["static", "synthetic", "local_harness", "real_runtime"]},
    "skill": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"const": "think-it-through"},
        "version": {"const": "0.4.0"}
      },
      "additionalProperties": false
    },
    "source_commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "package_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
    "runtime": {
      "type": "object",
      "required": ["id", "version"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
        "version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "tool": {
      "type": "object",
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      },
      "additionalProperties": false
    },
    "environment": {
      "type": "object",
      "required": ["os", "arch", "network_used"],
      "properties": {
        "os": {"type": "string", "minLength": 1},
        "arch": {"type": "string", "minLength": 1},
        "network_used": {"type": "boolean"},
        "node_version": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
      "uniqueItems": true
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "level", "status", "command_argv", "assertions"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "level": {"enum": ["L0", "L1", "L2", "L3", "L4", "L5"]},
          "status": {"enum": ["passed", "failed", "blocked"]},
          "command_argv": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string"}
          },
          "assertions": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "media_type", "sha256"],
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"
          },
          "media_type": {"type": "string", "minLength": 1},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "additionalProperties": false
      }
    },
    "redaction": {
      "type": "object",
      "required": ["secrets_removed", "personal_paths_removed", "unrelated_data_removed"],
      "properties": {
        "secrets_removed": {"type": "boolean"},
        "personal_paths_removed": {"type": "boolean"},
        "unrelated_data_removed": {"type": "boolean"},
        "notes": {"type": "string"}
      },
      "additionalProperties": false
    },
    "review": {
      "type": "object",
      "required": ["status", "reviewed_by", "reviewed_at"],
      "properties": {
        "status": {"enum": ["approved", "rejected", "candidate"]},
        "reviewed_by": {"type": "string", "minLength": 1},
        "reviewed_at": {"type": "string", "format": "date-time"}
      },
      "additionalProperties": false
    },
    "recorded_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": {"properties": {"kind": {"const": "real_runtime"}}},
      "then": {"required": ["runtime", "redaction"]}
    },
    {
      "if": {"properties": {"kind": {"enum": ["static", "local_harness"]}}},
      "then": {"required": ["tool"]}
    }
  ]
}
